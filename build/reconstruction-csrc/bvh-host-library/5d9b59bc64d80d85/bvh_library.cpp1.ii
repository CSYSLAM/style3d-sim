# 415 "/home/oem/code/agent/style3d-sim/build/toolchains/cuda-12.4/bin/..//include/thrust/detail/contiguous_storage.inl" 3
 contiguous_storage<T,Alloc> &contiguous_storage<T,Alloc>
    ::operator=(contiguous_storage &&other)
{
  if (size() > 0)
  {
    deallocate();
  }
  propagate_allocator(other);
  m_begin = std::move(other.m_begin);
  m_size = std::move(other.m_size);

  other.m_begin = pointer(static_cast<T*>(0));
  other.m_size = 0;

  return *this;
}


