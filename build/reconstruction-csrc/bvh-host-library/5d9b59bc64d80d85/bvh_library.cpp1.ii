struct Vec3InnerProduct {
    __attribute__((host)) __attribute__((device)) float operator()(const glm::vec3& a, const glm::vec3& b) const
    {
        return glm::dot(a, b);
    }
};

template<class Preconditioner>
struct PreconditionedResidualInnerProduct {
    __attribute__((host)) __attribute__((device)) float operator()(const glm::vec3& r, const Preconditioner& p) const
    {
        return glm::dot(p * r, r);
    }
};

