namespace synreal::kernel {



__attribute__((device)) __inline__ __attribute__((always_inline)) size_t thread_index()
{
    return static_cast<size_t>(blockIdx.x) * blockDim.x + threadIdx.x;
}



__attribute__((device)) __inline__ __attribute__((always_inline)) float guarded_ratio(float num, float den)
{
    if (fabsf(den) > 1e-30f && !std::isnan(den) && !std::isnan(num)) return num / den;
    return 0.0f;
}


__attribute__((device)) __inline__ __attribute__((always_inline)) glm::vec3 normalized_or_zero(const glm::vec3& v, float length, float threshold)
{
    if (length > threshold) return v / length;
    return glm::vec3(0.0f);
}



__attribute__((device)) __inline__ __attribute__((always_inline)) glm::vec3 min_components(const glm::vec3& a, const glm::vec3& b)
{
    return glm::vec3(fminf(a.x, b.x), fminf(a.y, b.y), fminf(a.z, b.z));
}

__attribute__((device)) __inline__ __attribute__((always_inline)) glm::vec3 max_components(const glm::vec3& a, const glm::vec3& b)
{
    return glm::vec3(fmaxf(a.x, b.x), fmaxf(a.y, b.y), fmaxf(a.z, b.z));
}


__attribute__((device)) __inline__ __attribute__((always_inline)) void atomic_add(glm::vec3* target, const glm::vec3& value)
{
    atomicAdd(&target->x, value.x);
    atomicAdd(&target->y, value.y);
    atomicAdd(&target->z, value.z);
}

__attribute__((device)) __inline__ __attribute__((always_inline)) void atomic_add(glm::mat3* target, const glm::mat3& value)
{
    for (int column = 0; column < 3; ++column)
        for (int row = 0; row < 3; ++row) atomicAdd(&(*target)[column][row], value[column][row]);
}

