                                              int valid_items = TILE_ITEMS)
  {

    AccumT items[ITEMS_PER_THREAD];

    if (IS_LAST_TILE)
    {


      BlockLoadT(temp_storage.load)
        .Load(d_in + tile_offset, items, valid_items, *(d_in + tile_offset));
    }
