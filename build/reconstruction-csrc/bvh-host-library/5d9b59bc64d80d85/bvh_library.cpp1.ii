 for_each_n(execution_policy<Derived> &policy,
             Input first,
             Size count,
             UnaryOp op)
  {
    typedef thrust::detail::wrapped_function<UnaryOp, void> wrapped_t;
    wrapped_t wrapped_op(op);

    cuda_cub::parallel_for(policy,
                           for_each_f<Input, wrapped_t>(first, wrapped_op),
                           count);

    return first + count;
  }


