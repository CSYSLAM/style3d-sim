                          T ThreadLoadVolatilePointer(
    T *ptr,
    Int2Type<false> )
{

    typedef typename UnitWord<T>::VolatileWord VolatileWord;

    constexpr int VOLATILE_MULTIPLE = sizeof(T) / sizeof(VolatileWord);

    T retval;
