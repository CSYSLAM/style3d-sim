# 353 "/home/oem/code/agent/style3d-sim/build/toolchains/cuda-12.4/bin/..//include/cub/agent/agent_radix_sort_onesweep.cuh" 3
   void TryShortCircuit(bit_ordered_type (&keys)[ITEMS_PER_THREAD], int (&bins)[BINS_PER_THREAD])
    {

        bool short_circuit = false;
#pragma unroll
        for (int u = 0; u < BINS_PER_THREAD; ++u)
        {
            if (FULL_BINS || ThreadBin(u) < RADIX_DIGITS)
            {
                short_circuit = short_circuit || bins[u] == TILE_ITEMS;
            }
        }
        short_circuit = CTA_SYNC_OR(short_circuit);
        if (!short_circuit) return;

        ShortCircuitCopy(keys, bins);
    }

    
# 371 "/home/oem/code/agent/style3d-sim/build/toolchains/cuda-12.4/bin/..//include/cub/agent/agent_radix_sort_onesweep.cuh"
   __attribute__((
