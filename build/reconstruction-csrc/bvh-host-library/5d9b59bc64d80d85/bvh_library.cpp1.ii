      keys2_end = (cub::min)(keys_count, start + size * 2);
    }



    int num_keys1 = static_cast<int>(keys1_end - keys1_beg);
    int num_keys2 = static_cast<int>(keys2_end - keys2_beg);


    KeyT keys_local[ITEMS_PER_THREAD];
    if (ping)
    {
