# 152 "/home/oem/code/agent/style3d-sim/build/toolchains/cuda-12.4/bin/..//include/thrust/system/cuda/detail/util.h"
__attribute__((
# 152 "/home/oem/code/agent/style3d-sim/build/toolchains/cuda-12.4/bin/..//include/thrust/system/cuda/detail/util.h" 3
host
# 152 "/home/oem/code/agent/style3d-sim/build/toolchains/cuda-12.4/bin/..//include/thrust/system/cuda/detail/util.h"
)) __inline__ __attribute__((always_inline)) 
# 152 "/home/oem/code/agent/style3d-sim/build/toolchains/cuda-12.4/bin/..//include/thrust/system/cuda/detail/util.h" 3
                    cudaError_t
trivial_copy_from_device(Type * dst,
                         Type const * src,
                         size_t count,
                         cudaStream_t stream)
{
  cudaError status = cudaSuccess;
  if (count == 0) return status;

  status = ::cudaMemcpyAsync(dst,
                             src,
                             sizeof(Type) * count,
                             cudaMemcpyDeviceToHost,
                             stream);
  cudaStreamSynchronize(stream);
  return status;
}

