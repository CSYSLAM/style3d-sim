# 190 "/home/oem/code/agent/style3d-sim/build/toolchains/cuda-12.4/bin/..//include/thrust/system/cuda/detail/util.h" 3
host
# 190 "/home/oem/code/agent/style3d-sim/build/toolchains/cuda-12.4/bin/..//include/thrust/system/cuda/detail/util.h"
)) __attribute__((
# 190 "/home/oem/code/agent/style3d-sim/build/toolchains/cuda-12.4/bin/..//include/thrust/system/cuda/detail/util.h" 3
        device
