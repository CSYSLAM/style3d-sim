struct __attribute__ ((__visibility__("default"))) tuple_size<__enable_if_tuple_size_imp< volatile _Tp,
    __enable_if_t<!is_const<_Tp>::value>, integral_constant<size_t, sizeof(tuple_size<_Tp>)>>>
    : public integral_constant<size_t, tuple_size<_Tp>::value>
{};

template <class _Tp>
struct __attribute__ ((__visibility__("default")))
    tuple_size<__enable_if_tuple_size_imp< const volatile _Tp, integral_constant<size_t, sizeof(tuple_size<_Tp>)>>>
    : public integral_constant<size_t, tuple_size<_Tp>::value>
{};

template <class... _Tp>
struct __attribute__ ((__visibility__("default"))) tuple_size<tuple<_Tp...> > : public integral_constant<size_t, sizeof...(_Tp)>
{};

