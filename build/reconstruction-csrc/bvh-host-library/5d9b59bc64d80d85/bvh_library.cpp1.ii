                                   void MergePathSearch(
    OffsetT diagonal,
    AIteratorT a,
    BIteratorT b,
    OffsetT a_len,
    OffsetT b_len,
    CoordinateT& path_coordinate)
{

    using T = cub::detail::value_t<AIteratorT>;

    OffsetT split_min = (((0) > (diagonal - b_len)) ? (0) : (diagonal - b_len));
    OffsetT split_max = (((a_len) < (diagonal)) ? (a_len) : (diagonal));

    while (split_min < split_max)
    {
        OffsetT split_pivot = (split_min + split_max) >> 1;
        if (a[split_pivot] <= b[diagonal - split_pivot - 1])
        {

            split_min = split_pivot + 1;
        }
        else
        {

            split_max = split_pivot;
        }
    }

    path_coordinate.x = (((a_len) < (split_min)) ? (a_len) : (split_min));
    path_coordinate.y = diagonal - split_min;
}
