 template<length_t L, qualifier Q>
 __attribute__((device)) __attribute__((host)) inline vec<L, uint, Q> uaddCarry(vec<L, uint, Q> const& x, vec<L, uint, Q> const& y, vec<L, uint, Q>& Carry)
 {
