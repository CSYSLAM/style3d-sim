# 213 "/home/oem/code/agent/style3d-sim/build/toolchains/cuda-12.4/bin/..//include/thrust/detail/contiguous_storage.inl" 3
 void contiguous_storage<T,Alloc>
    ::allocate(size_type n)
{
  if(n > 0)
  {
    m_begin = iterator(alloc_traits::allocate(m_allocator,n));
    m_size = n;
  }
  else
  {
    m_begin = iterator(pointer(static_cast<T*>(0)));
    m_size = 0;
  }
}

