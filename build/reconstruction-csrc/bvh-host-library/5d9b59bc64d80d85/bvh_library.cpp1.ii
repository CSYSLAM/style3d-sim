    ReduceStep(unsigned int input, cub::Sum , int last_lane, int offset)
    {
        unsigned int output;
        int shfl_c = last_lane | SHFL_C;


        asm volatile(
            "{"
            "  .reg .u32 r0;"
            "  .reg .pred p;"
            "  shfl.sync.down.b32 r0|p, %1, %2, %3, %5;"
